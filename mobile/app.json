{
  "expo": {
    "name": "GymBodyAI",
    "slug": "mobile",
    "version": "1.2.4",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "gymbodyai",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "bundleIdentifier": "com.gymbodyai.app",
      "infoPlist": {
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "gymbodyai",
              "com.googleusercontent.apps.715798761426-vpka1e4obfhgut4uo1d9ibf1h8qe51qk"
            ]
          }
        ],
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        },
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.gymbodyai.app",
      "adaptiveIcon": {
        "backgroundColor": "#0B0D12",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-apple-authentication",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#0B0D12",
          "dark": {
            "backgroundColor": "#0B0D12"
          }
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Gelişim ve yemek fotoğraflarını galeriden seçebilmen için fotoğraflarına erişim gerekiyor.",
          "cameraPermission": "Gelişim ve yemek fotoğraflarını çekebilmen için kameraya erişim gerekiyor."
        }
      ],
      "expo-localization",
      "./plugins/withRemoveAdIdPermission",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.715798761426-vpka1e4obfhgut4uo1d9ibf1h8qe51qk"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5c9aac65-0abe-4a2a-b63e-b9ced523f384"
      }
    },
    "owner": "bahri1"
  }
}
