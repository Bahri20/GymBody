{
  "expo": {
    "name": "GymBodyAI",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "gymbodyai",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.gymbodyai.app",
      "infoPlist": {
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "gymbodyai",
              "com.googleusercontent.apps.715798761426-vpka1e4obfhgut4uo1d9ibf1h8qe51qk"
            ]
          }
        ],
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        },
        "NSUserTrackingUsageDescription": "İzin verirsen sana daha uygun reklamlar göstermek için reklam tanımlayıcını kullanırız. VIP üyeler reklam görmez.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.gymbodyai.app",
      "adaptiveIcon": {
        "backgroundColor": "#0B0D12",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "com.google.android.gms.permission.AD_ID"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Gelişim ve yemek fotoğraflarını galeriden seçebilmen için fotoğraflarına erişim gerekiyor.",
          "cameraPermission": "Gelişim ve yemek fotoğraflarını çekebilmen için kameraya erişim gerekiyor."
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3940256099942544~3347511713",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511"
        }
      ],
      [
        "expo-tracking-transparency",
        {
          "userTrackingPermission": "İzin verirsen sana daha uygun reklamlar göstermek için reklam tanımlayıcını kullanırız. VIP üyeler reklam görmez."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5c9aac65-0abe-4a2a-b63e-b9ced523f384"
      }
    },
    "owner": "bahri1"
  }
}
