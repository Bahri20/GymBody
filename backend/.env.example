# Bu dosya örnektir — gerçek değerleri deploy platformunun env kısmına gir (buraya YAZMA).
# Render: Dashboard > Environment · Cloud Run: env.yaml + --env-vars-file (bkz. DEPLOY.md)

# --- Database ---
MONGO_URI=

# --- Auth ---
JWT_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
ADMIN_KEY=

# --- Sign in with Apple / Google (client ID'ler) ---
GOOGLE_WEB_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=

# --- Media (Cloudinary) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- AI: Google Gemini / Vertex AI ---
GEMINI_API_KEY=
GCP_PROJECT_ID=
GCP_LOCATION=
GOOGLE_CREDENTIALS_JSON=      # Vertex AI service-account JSON (tek satır)
VERTEX_PROXY_URL=             # Vertex çağrılarını proxy'leyen Cloudflare Worker URL'i
VERTEX_PROXY_SECRET=          # Worker ile paylaşılan gizli anahtar

# --- Üçüncü taraf ---
RAPIDAPI_KEY=

# --- Zamanlanmış görevler ---
DISABLE_NODE_CRON=      # Cloud Run'da 1 (görevleri Cloud Scheduler tetikler); Render'da boş bırak
CRON_SECRET=            # /internal/cron endpoint'lerinin anahtarı — üret: openssl rand -hex 32

# PORT otomatik gelir (platform enjekte eder), elle girme.
